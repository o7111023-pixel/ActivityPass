ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
ACTIVITYPASS_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_HERE
PUBLIC_BASE_URL=https://your-domain.example
ALLOWED_HOSTS=your-domain.example,*.vercel.app
COOKIE_SECURE=true
ENABLE_DOCS=false
POSTGRES_DB=activitypass
POSTGRES_USER=activitypass
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD

SEED_DEMO_USERS=false

# Demo passwords are intentionally not configured in production.
