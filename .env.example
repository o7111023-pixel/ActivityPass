# Development defaults. Never commit your real .env file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./activitypass.db
ACTIVITYPASS_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
COOKIE_SECURE=false
ENABLE_DOCS=true

# Production example:
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# ACTIVITYPASS_SECRET_KEY=<strong-random-secret>
# PUBLIC_BASE_URL=https://your-domain.example
# ALLOWED_HOSTS=your-domain.example,*.vercel.app
# COOKIE_SECURE=true
# ENABLE_DOCS=false

# Local demo accounts. Set false before any public deployment.
SEED_DEMO_USERS=true
DEMO_ADMIN_PASSWORD=choose-a-local-password
DEMO_USER_PASSWORD=choose-a-local-password
